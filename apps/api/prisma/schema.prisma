// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Instrument {
  piano
  guitar
  bass4
  bass5
  drums
}

enum Difficulty {
  easy
  medium
  hard
  expert
}

enum Grade {
  S
  A_PLUS  @map("A+")
  A
  B_PLUS  @map("B+")
  B
  C
  D
  F
}

enum PlanTier {
  FREE
  BASIC
  PRO
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum LessonCategory {
  abrsm
  classical
  jazz
  pop
  exercises
  custom
}

enum LessonSubcategory {
  // ABRSM
  grade1
  grade2
  grade3
  grade4
  grade5

  // Classical periods
  baroque
  classical_period
  romantic
  modern

  // Jazz
  jazz_basics
  blues
  jazz_standards
  improvisation

  // Pop
  pop_beginner
  pop_chords
  pop_songs

  // Exercises
  hanon
  czerny
  scales_arpeggios
  sight_reading

  // Custom
  theory_builder
  ear_training
  fun_challenges
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatar       String?

  // XP & Progression
  totalXP      Int      @default(0)
  level        Int      @default(1)
  streak       Int      @default(0)
  lastActiveAt DateTime @default(now())

  // Plan
  plan         PlanTier @default(FREE)
  role         Role     @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  progress     LessonProgress[]
  scores       Score[]
  refreshTokens RefreshToken[]

  @@index([totalXP])
  @@index([level])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lesson {
  id          String     @id @default(uuid())
  name        String
  description String
  instrument  Instrument
  difficulty  Difficulty
  bpm         Int
  notes       Json       // Note[]
  order       Int
  xpReward    Int        @default(100)

  // ── New categorisation fields ──────────────────────────
  category       LessonCategory     @default(custom)
  subcategory    LessonSubcategory?
  composer       String?            // "Bach", "Hanon", "Chopin"
  songTitle      String?            // "Minuet in G", "Exercise No.1"
  requiredPlan   PlanTier           @default(FREE)
  keySignature   String?            // "C" | "G" | "Am" etc
  // ───────────────────────────────────────────────────────

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  progress    LessonProgress[]
  scores      Score[]

  @@index([instrument])
  @@index([instrument, category])
  @@index([instrument, category, subcategory])
  @@index([instrument, difficulty])
  @@index([order])
}

model LessonProgress {
  id         String    @id @default(uuid())
  userId     String
  lessonId   String
  unlocked   Boolean   @default(false)
  completed  Boolean   @default(false)
  bestScore  Float?
  attempts   Int       @default(0)
  lastPlayed DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}
model Score {
  id             String     @id @default(uuid())
  userId         String
  lessonId       String
  noteAccuracy   Float
  timingAccuracy Float
  rhythmScore    Float
  overall        Float
  grade          Grade
  hits           Int
  misses         Int
  totalNotes     Int
  bpmPlayed      Int?

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}
