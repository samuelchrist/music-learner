{
  "name": "music-learner",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev":        "turbo run dev",
    "build":      "turbo run build",
    "test":       "turbo run test",
    "lint":       "turbo run lint",
    "clean":      "turbo run clean",
    "db:migrate": "turbo run db:migrate",
    "db:seed":    "turbo run db:seed"
  },
  "devDependencies": {
    "turbo":       "latest",
    "typescript":  "^5.3.0",
    "prettier":    "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "engines": { "node": ">=20.0.0" }
}
